{
    "name": "db-og-worker",
    "private": true,
    "main": "worker.js",
    "scripts": {
        "deploy": "wrangler deploy",
        "format": "prettier --write '*.{json,jsonc,js}' 'src/**/*.{js,ts}'",
        "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,jsonc,js}' 'src/**/*.{js,ts}'",
        "types": "wrangler types",
        "typecheck": "wrangler types --check && tsc --noEmit"
    },
    "license": "MIT",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^10.13.0",
        "typescript": "~6.0.3",
        "wrangler": "^4.152.0"
    }
}
